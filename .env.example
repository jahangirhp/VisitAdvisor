APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

MONGODB_URI=
MONGODB_DATABASE=visitadvisor

# Required for content generation and semantic retrieval; never paste keys into tracked files.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini-2025-04-14

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VECTOR_INDEX_NAME=visitadvisor_identity_v1

# Phase 5 label OCR uses the same OPENAI_API_KEY.
OCR_MODEL=gpt-4.1-mini-2025-04-14
OCR_TIMEOUT_SECONDS=30

# Experimental visual candidates only; requires the visual extra and downloaded model.
VISUAL_ENABLED=false

# Server camera: one location and 2–12 explicitly selected reference-covered objects.
# Object IDs are a JSON array. Model files live under LIVE_CAMERA_BUNDLE.
# LIVE_CAMERA_LOCATION_ID=YOUR_LOCATION_ID
# LIVE_CAMERA_OBJECT_IDS=["FIRST_OBJECT_ID","SECOND_OBJECT_ID"]
LIVE_CAMERA_REFRESH_SECONDS=30
LIVE_CAMERA_BUNDLE=.local/live-camera
